%% Whole PSL cover, front + back
\newcommand*{\sucover}{
  \AfterPreamble{\sufrontcover{}}
  \AtEndDocument{\subackcover{}}
}

%% Front PSL cover
\newcommand*{\sufrontcover}{
  \begin{sufontenv}
    \thispagestyle{empty}
    \begin{tikzpicture}[overlay, remember picture,
      text centered, align=center]

      %% background PSL logo
      \node[on background layer]
      at (current page.center) {\includegraphics{\@suassetspath/cover_manuscript.pdf}};
      %

      
      %% node origin
      \coordinate (o) at (current page.center);
      \coordinate[yshift=-0mm] (o2) at (o);
      
      %% institute
      % \node[xshift=-86mm, yshift=75mm, anchor=north west] at (o) {
      %   \begin{minipage}[h]{.45\paperwidth}
      %     \color{SUblue}
      %     \fontsize{14}{17}\selectfont
      %     Pr\'{e}par\'{e}e au \@institute{}\unskip\strut\par
      %     \if@cotutelle
      %     Dans le cadre d'une cotutelle avec \@otherinstitute{}\unskip\strut\par
      %     \fi
      %   \end{minipage}
      % };

      %% thesis title
      \if@cotutelle
      \node[yshift=0mm] at (o2) {
        \begin{minipage}[h]{.85\paperwidth}
          \centering
          \fontsize{18}{22}\selectfont
          \textbf{\@title{}}\unskip\strut\par
          \vspace{5mm}
          \color{SUblue}
          \@entitle{}\unskip\strut\par
        \end{minipage}
      };
      \else
      \node[yshift=35mm, xshift=3mm] at (o2) {
        \begin{minipage}[h]{.85\paperwidth}
          \centering
          \fontsize{22}{24}\selectfont
          \textbf{\@title{}}\unskip\strut\par
        \end{minipage}
      };
      \fi
        
      \if@frtitle
      \node[yshift=16mm, xshift=3mm] at (o2) {
        \begin{minipage}[h]{.70\paperwidth}
          \centering
          \fontsize{16}{16}\selectfont
          \textbf{\@frtitle{}}\unskip\strut\par
        \end{minipage}
       };

        \coordinate[yshift = 10mm] (o3) at (o2);

      %% author
      \node[xshift=-86mm, yshift=-8mm, anchor=north west] (autho) at (o3) {
        \begin{minipage}[h]{.3\paperwidth}
          \SUbluelabel{Thèse soutenue par}\unskip\strut\par
          \vspace{1mm}
          {\fontsize{16}{19}\selectfont\textbf{\@author{}}}\unskip\strut\par
          \vspace{1mm}
          {\fontsize{13}{17}\selectfont Le \@date{}}\unskip\strut\par
        \end{minipage}
      };

      %% doctoral school
      \node[xshift=0mm, yshift=-4mm, anchor=north west] (docsc) at (autho.south west) {
        \begin{minipage}[h]{.3\paperwidth}
          \SUbluelabel{\'{E}cole doctorale n\textsuperscript{o}\@doctoralschoolnumber{}}
          \unskip\strut\par
            \vspace{1mm}
            \begin{flushleft} \unskip
            {\fontsize{13}{17}\selectfont\@doctoralschoolname{}}
            \end{flushleft} 
        \end{minipage}
      };

      %% doctoral specialty
      \node[xshift=0mm, yshift=-4mm, anchor=north west] (docspe) at (docsc.south west) {
        \begin{minipage}[h]{.3\paperwidth}
          \SUbluelabel{Sp\'{e}cialit\'{e}s}
          \unskip\strut\par
          \vspace{1mm}
          {\fontsize{13}{17}\selectfont\@specialty{}}
        \end{minipage}
      };

      %% labo
      \node[xshift=0mm, yshift=-4mm, anchor=north west] (labo) at (docspe.south west) {
        \begin{minipage}[h]{.4\paperwidth}
          \SUbluelabel{Pr\'{e}par\'{e}e au}
            \unskip\strut\par
            \vspace{1mm}
            \begin{flushleft} \unskip
            {\fontsize{13}{17}\selectfont \@laboratory{}}
            \end{flushleft} 
        \end{minipage}
      };

      %% jury
      %\node[fill=lightgray!10, xshift=-15mm, yshift=-6.5mm, anchor=north west] (compo) at (o3) {
      \node[fill=SUblue!10, xshift=-15mm, yshift=-8mm, anchor=north west] (compo) at (o3) {
        \begin{minipage}[h]{105mm}
          \vspace{2mm}
          {\hspace{1mm}\color{SUblue}\fontsize{12}{15}\selectfont Composition du jury :}

          \vspace{5mm}
          \hspace{-2mm}
          \fontsize{11}{13}\selectfont
          \begin{tabularx}{105mm}{p{72mm}p{35mm}}
            %\sujurystylepresident{\@jiname}{\@jitt}%{\@jirole}
            \sujurystyle{\@jiname}{\@jitt}{\@jirole}
            \sujurystyle{\@jiiname}{\@jiitt}{\@jiirole}
            \sujurystyle{\@jiiiname}{\@jiiitt}{\@jiiirole}
            \sujurystyle{\@jivname}{\@jivtt}{\@jivrole}
            \sujurystyle{\@jvname}{\@jvtt}{\@jvrole}
            \sujurystyle{\@jviname}{\@jvitt}{\@jvirole}
            \sujurystyle{\@jviiname}{\@jviitt}{\@jviirole}
            \sujurystyle{\@jviiiname}{\@jviiitt}{\@jviiirole}
            \sujurystyle{\@jixname}{\@jixtt}{\@jixrole}
            \sujurystyle{\@jxname}{\@jxtt}{\@jxrole}
            \sujurystyle{\@jxiname}{\@jxitt}{\@jxirole}
            \sujurystyle{\@jxiiname}{\@jxiitt}{\@jxiirole}
          \end{tabularx}
          \vspace{0mm}
        \end{minipage}
      };

      %% PSL institute logo
       \node[xshift=0mm, yshift=-226mm] at (o) {
          \includegraphics[scale=.75]{\@suassetspath/logos_labo}
       };

      %% other institute logo (cotutelle)
      \if@cotutelle
      \node[xshift=65mm, yshift=125mm] at (o) {
        \includegraphics[height=1.8cm]{\@logoinstitute}
      };
      \fi

    \end{tikzpicture}
  \end{sufontenv}
  \clearpage
  \mbox{}
  \thispagestyle{empty}
  \clearpage
  \setcounter{page}{1}
}

