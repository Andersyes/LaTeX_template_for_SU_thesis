%% Some text styling
\newcommand{\SUbluelabel}[1]{{\color{SUblue}\fontsize{12}{15}\selectfont #1}}
% \newcommand{\sujurystyle}[3]{
%   \ifdefempty{#1}{}{
%     \fontsize{10}{12}\selectfont #1 & \\
