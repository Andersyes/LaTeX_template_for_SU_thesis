\newcommand{\sujurystylepresident}[2]{
  \ifdefempty{#1}{}{
    \fontsize{10}{12}\selectfont #1 & \emph{Président du jury}\\
    #2 \\[3mm]
  }
}

\newcommand{\subacknode}[4]{
  \begin{minipage}[h]{.7\paperwidth} % 0.8
    {\color{SUblue}\fontsize{11}{14}\selectfont #1}\unskip\strut\par
    \vspace{-2.5mm}
    \tikz{\draw[SUblue, line width=.5mm] (0, 0) -- (14.7, 0);} % (16.8, 0) 16.8=0.8*21

    \vspace{1mm} %old 3 mm
    {\color{black}\fontsize{#3}{#4}\selectfont #2}\unskip\strut\par
  \end{minipage}
}

