\@writefile{toc}{\contentsline {subsubsection}{\numberline {\uppercase {i{}\relax }.5.2.3}Lapse-rate feedback}{42}{subsubsection.1.5.2.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {I.19}{\ignorespaces Illustrations of Arctic amplification feedbacks. Panel A is a schematics of the sea ice albedo feedback principle. First, a positive forcing induces an increase in temperature. This causes the melting of sea ice and snow, which leads to a decrease in albedo. Short wave radiation is then more strongly absorbed by the surface, which amplifies the temperature increase induced by the initial forcing, closing the positive feedback loop. Panel B: schematics of the lapse-rate feedback effect. The inversion of the vertical temperature profile induced, in the case of a surface warming of $\Delta T_{\text  {surf}}$, a negative buoyancy \textbf  {B} below the inversion altitude. The heat gain is then poorly transported to the upper layers of the atmosphere, and the warming $\Delta T_{TOA}$ at the tropopause is minimal.}}{42}{figure.caption.24}\protected@file@percent }
\newlabel{fig:aa_feedbacks}{{I.19}{42}{Illustrations of Arctic amplification feedbacks. Panel A is a schematics of the sea ice albedo feedback principle. First, a positive forcing induces an increase in temperature. This causes the melting of sea ice and snow, which leads to a decrease in albedo. Short wave radiation is then more strongly absorbed by the surface, which amplifies the temperature increase induced by the initial forcing, closing the positive feedback loop. Panel B: schematics of the lapse-rate feedback effect. The inversion of the vertical temperature profile induced, in the case of a surface warming of $\Delta T_{\text {surf}}$, a negative buoyancy \textbf {B} below the inversion altitude. The heat gain is then poorly transported to the upper layers of the atmosphere, and the warming $\Delta T_{TOA}$ at the tropopause is minimal}{figure.caption.24}{}}
\newlabel{fig:aa_feedbacks@cref}{{[figure][19][1]I.19}{[1][42][]42}}
