\@writefile{lof}{\contentsline {figure}{\numberline {I.10}{\ignorespaces Heterogeneous ice nucleation. Panel 1 is a schematic of the formation of an ice embryo in contact of an INP. The contact angle $\theta $ and the surface tensions $\sigma _i$ of the different actors are represented (adapted from \citet {lohmann_introduction_2016}). Panel B is the energy barrier $\Delta G$ expressed in thermal units, function of the ice embryo radius, for homogeneous and heterogeneous ice nucleation. The curves maximum is the critical Gibbs free energy that, once reached allows the embryo to grow as an ice crystal.}}{29}{figure.caption.15}\protected@file@percent }
\newlabel{fig:hetero_nucleation}{{I.10}{29}{Heterogeneous ice nucleation. Panel 1 is a schematic of the formation of an ice embryo in contact of an INP. The contact angle $\theta $ and the surface tensions $\sigma _i$ of the different actors are represented (adapted from \citet {lohmann_introduction_2016}). Panel B is the energy barrier $\Delta G$ expressed in thermal units, function of the ice embryo radius, for homogeneous and heterogeneous ice nucleation. The curves maximum is the critical Gibbs free energy that, once reached allows the embryo to grow as an ice crystal}{figure.caption.15}{}}
\newlabel{fig:hetero_nucleation@cref}{{[figure][10][1]I.10}{[1][29][]29}}
