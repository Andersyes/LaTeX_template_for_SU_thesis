\@writefile{lof}{\contentsline {figure}{\numberline {I.4}{\ignorespaces Trend from implemented policies (red line) compared to emissions scenarios that would allow to stay below 1.5°C (cyan line) of below 2.0°C (green line) of global warming. A scenario that takes into account the National Determined Contributions (NDCs) discussed during COP26 is also represented (dark blue line). The NDCs represent the free of result commitments made by countries to reduce GHG emissions and enhance resilience to climate change impacts. Graphics from \citet {intergovernemental_panel_on_climate_change_climate_2023}}}{11}{figure.caption.7}\protected@file@percent }
\newlabel{fig:projections_scenarios}{{I.4}{11}{Trend from implemented policies (red line) compared to emissions scenarios that would allow to stay below 1.5°C (cyan line) of below 2.0°C (green line) of global warming. A scenario that takes into account the National Determined Contributions (NDCs) discussed during COP26 is also represented (dark blue line). The NDCs represent the free of result commitments made by countries to reduce GHG emissions and enhance resilience to climate change impacts. Graphics from \citet {intergovernemental_panel_on_climate_change_climate_2023}}{figure.caption.7}{}}
\newlabel{fig:projections_scenarios@cref}{{[figure][4][1]I.4}{[1][11][]11}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\uppercase {i{}\relax }.2.5}Implication for scientific research}{12}{subsection.1.2.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {I.5}{\ignorespaces Graphical abstract of the key aspects of the IPCC Assessment Report 6, Technical Summary. The upper panels present temperature projections for the five SSPs and three ranges of ECS. The lower panels show the responses of two climate indexes for three levels of warming. The association of upper and lower panels allows to catch a glimpse of the timeline for future global warming consequences. Graphics from \citet {intergovernemental_panel_on_climate_change_climate_2023}}}{14}{figure.caption.8}\protected@file@percent }
\newlabel{fig:climate_projections}{{I.5}{14}{Graphical abstract of the key aspects of the IPCC Assessment Report 6, Technical Summary. The upper panels present temperature projections for the five SSPs and three ranges of ECS. The lower panels show the responses of two climate indexes for three levels of warming. The association of upper and lower panels allows to catch a glimpse of the timeline for future global warming consequences. Graphics from \citet {intergovernemental_panel_on_climate_change_climate_2023}}{figure.caption.8}{}}
\newlabel{fig:climate_projections@cref}{{[figure][5][1]I.5}{[1][12][]14}}
