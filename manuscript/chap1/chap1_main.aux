\@writefile{lof}{\contentsline {figure}{\numberline {I.1}{\ignorespaces Elements of proof for a global warming. Panel A shows the change in global surface temperature relative to the average of 1850-1900, as reconstructed (1-2000) and observation data (1850-2020). Panel B is a zoom of panel A with observed and simulated data, using human \& natural and only natural factors \citep {masson-delmotte_summary_2021}. Panel C present the top ten of the warmer years in global average (source: \url  {https://www.climatecentral.org/}). Panel D is the global air surface temperature yearly evolution of the three years of my PhD, compared to 1992, the year of the third Earth summit when the United Nations committed to protect the future generations (data from C3S/ECMWF, ERA5, Copernicus: \url  {https://pulse.climate.copernicus.eu/}).}}{7}{figure.caption.4}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:warming_proofs}{{I.1}{7}{Elements of proof for a global warming. Panel A shows the change in global surface temperature relative to the average of 1850-1900, as reconstructed (1-2000) and observation data (1850-2020). Panel B is a zoom of panel A with observed and simulated data, using human \& natural and only natural factors \citep {masson-delmotte_summary_2021}. Panel C present the top ten of the warmer years in global average (source: \url {https://www.climatecentral.org/}). Panel D is the global air surface temperature yearly evolution of the three years of my PhD, compared to 1992, the year of the third Earth summit when the United Nations committed to protect the future generations (data from C3S/ECMWF, ERA5, Copernicus: \url {https://pulse.climate.copernicus.eu/})}{figure.caption.4}{}}
\newlabel{fig:warming_proofs@cref}{{[figure][1][1]I.1}{[1][6][]7}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {\uppercase {i{}\relax }.2.3.2}The anthropogenic forcing}{8}{subsubsection.1.2.3.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {I.2}{\ignorespaces The "Keeling Curve": this graph illustrates the evolution of atmospheric \ce {CO2} concentration over the last two thousand years. Named after Charles D. Keeling who initiated the measurement project of continuous \ce {CO2} measurement at Mauna Loa observatory (Hawaii, U.S.) in 1958 \citep {keeling_atmospheric_2017}, the data is completed by ice core measurements \citep {rubino_revised_2019}. The industrial revolution is clearly highlighted by the dramatic increase that started in the late 18{th} century. Data can be found here: \url  {https://keelingcurve.ucsd.edu/}.}}{9}{figure.caption.5}\protected@file@percent }
\newlabel{fig:keeling_curve}{{I.2}{9}{The "Keeling Curve": this graph illustrates the evolution of atmospheric \ce {CO2} concentration over the last two thousand years. Named after Charles D. Keeling who initiated the measurement project of continuous \ce {CO2} measurement at Mauna Loa observatory (Hawaii, U.S.) in 1958 \citep {keeling_atmospheric_2017}, the data is completed by ice core measurements \citep {rubino_revised_2019}. The industrial revolution is clearly highlighted by the dramatic increase that started in the late 18\up {th} century. Data can be found here: \url {https://keelingcurve.ucsd.edu/}}{figure.caption.5}{}}
\newlabel{fig:keeling_curve@cref}{{[figure][2][1]I.2}{[1][8][]9}}
\@writefile{lof}{\contentsline {figure}{\numberline {I.3}{\ignorespaces Historical \ce {CO2} emissions by regions and activities (A), put into perspective with the evolution of primary energy consumption by source. Data from \textit  {Our World in Data}: \url  {https://ourworldindata.org/}.}}{10}{figure.caption.6}\protected@file@percent }
\newlabel{fig:energies}{{I.3}{10}{Historical \ce {CO2} emissions by regions and activities (A), put into perspective with the evolution of primary energy consumption by source. Data from \textit {Our World in Data}: \url {https://ourworldindata.org/}}{figure.caption.6}{}}
\newlabel{fig:energies@cref}{{[figure][3][1]I.3}{[1][9][]10}}
