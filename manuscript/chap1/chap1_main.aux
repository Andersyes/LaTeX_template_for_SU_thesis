\@writefile{lof}{\contentsline {figure}{\numberline {I.15}{\ignorespaces Schematics of the sea ice albedo feedback principle. First, a positive forcing induces an increase in temperature. This causes the melting of sea ice and snow, which leads to a decrease in albedo. Short wave radiation is then more strongly absorbed by the surface, which amplifies the temperature increase induced by the initial forcing, closing the positive feedback loop.}}{34}{figure.caption.18}\protected@file@percent }
\newlabel{fig:albedo_feedback}{{I.15}{34}{Schematics of the sea ice albedo feedback principle. First, a positive forcing induces an increase in temperature. This causes the melting of sea ice and snow, which leads to a decrease in albedo. Short wave radiation is then more strongly absorbed by the surface, which amplifies the temperature increase induced by the initial forcing, closing the positive feedback loop}{figure.caption.18}{}}
\newlabel{fig:albedo_feedback@cref}{{[figure][15][1]I.15}{[1][33][]34}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {\uppercase {i{}\relax }.5.2.3}Lapse-rate feedback}{34}{subsubsection.1.5.2.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {I.16}{\ignorespaces Schematics of the lapse-rate feedback effect. The inversion of the vertical temperature profile induced, in the case of a surface warming of $_{surf}$, a negative buoyancy \textbf  {B} below the inversion altitude. The heat gain is then poorly transported to the upper layers of the atmosphere, and the warming $_{TOA}$ at the tropopause is minimal.}}{35}{figure.caption.19}\protected@file@percent }
\newlabel{fig:lapserate}{{I.16}{35}{Schematics of the lapse-rate feedback effect. The inversion of the vertical temperature profile induced, in the case of a surface warming of $\DeltaT _{surf}$, a negative buoyancy \textbf {B} below the inversion altitude. The heat gain is then poorly transported to the upper layers of the atmosphere, and the warming $\DeltaT _{TOA}$ at the tropopause is minimal}{figure.caption.19}{}}
\newlabel{fig:lapserate@cref}{{[figure][16][1]I.16}{[1][34][]35}}
