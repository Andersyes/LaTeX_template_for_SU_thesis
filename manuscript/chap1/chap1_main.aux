\@writefile{lof}{\contentsline {figure}{\numberline {I.5}{\ignorespaces Trend from implemented policies (red line) compared to emissions scenarios that would allow to stay below 1.5°C (cyan line) of below 2.0°C (green line) of global warming. A scenario that takes into account the National Determined Contributions (NDCs) discussed during COP26 is also represented (dark blue line). The NDCs represent the free of result commitments made by countries to reduce GHG emissions and enhance resilience to climate change impacts. Graphics from \citet {intergovernemental_panel_on_climate_change_climate_2023}}}{14}{figure.caption.8}\protected@file@percent }
\newlabel{fig:projections_scenarios}{{I.5}{14}{Trend from implemented policies (red line) compared to emissions scenarios that would allow to stay below 1.5°C (cyan line) of below 2.0°C (green line) of global warming. A scenario that takes into account the National Determined Contributions (NDCs) discussed during COP26 is also represented (dark blue line). The NDCs represent the free of result commitments made by countries to reduce GHG emissions and enhance resilience to climate change impacts. Graphics from \citet {intergovernemental_panel_on_climate_change_climate_2023}}{figure.caption.8}{}}
\newlabel{fig:projections_scenarios@cref}{{[figure][5][1]I.5}{[1][13][]14}}
