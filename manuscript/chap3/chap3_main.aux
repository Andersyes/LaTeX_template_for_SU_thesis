\@writefile{lof}{\contentsline {figure}{\numberline {III.12}{\ignorespaces Same as \cref  {fig:source_INP_moccha} for the ARTofMELT campaign. Panel A is the raw ratio of the \SI {10}{\percent } highest observed concentrations. Panel B is the raw ratio of the \SI {33}{\percent } lowest observed concentrations. Yellow to red indicate detection signal, while the blueish colour means no signal. Panel C is the composite ratio (c.f. \cref  {P1sec:improved_method}), the actual identification results. Panel D is the time series of INP concentrations measured during the campaign for four activation temperatures.}}{84}{figure.caption.44}\protected@file@percent }
\newlabel{fig:source_INP_artofmelt}{{III.12}{84}{Same as \cref {fig:source_INP_moccha} for the ARTofMELT campaign. Panel A is the raw ratio of the \SI {10}{\percent } highest observed concentrations. Panel B is the raw ratio of the \SI {33}{\percent } lowest observed concentrations. Yellow to red indicate detection signal, while the blueish colour means no signal. Panel C is the composite ratio (c.f. \cref {P1sec:improved_method}), the actual identification results. Panel D is the time series of INP concentrations measured during the campaign for four activation temperatures}{figure.caption.44}{}}
