}

@article{yankofsky_basic_1981,
	title = {Some {Basic} {Characteristics} of {Bacterial} {Freezing} {Nuclei}},
	volume = {20},
	issn = {1520-0450},
	url = {https://journals.ametsoc.org/view/journals/apme/20/9/1520-0450_1981_020_1013_sbcobf_2_0_co_2.xml},
	doi = {10.1175/1520-0450(1981)020<1013:SBCOBF>2.0.CO;2},
	abstract = {Abstract Freezing spectra of INA bacteria from different parts of the world were compared. A slight increase in efficiency of freezing nuclei produced by strains from warmer climates was observed. Whole cells of the most efficient strain produced nuclei active at temperatures ranging from −2 to −10°C, whereas fragments from these cells exhibited activity only at −8 to −10°C. In all cases, the frequency of active cells in a population proved low. Thus, activity at −8 to −10°C was evidenced by 1 cell in about 300, the corresponding ratio being 1 in 104 at −2 to −4°C. It was shown in several ways that the variety of “freezer” individuals was not due to a need for multicell aggregation or any other cooperative process. Also, the time at which a given individual in a cell population expressed its latent freezing potential was shown to vary with time and cell physiological state.},
	language = {EN},
	number = {9},
	urldate = {2023-08-28},
	journal = {Journal of Applied Meteorology and Climatology},
	author = {Yankofsky, S. A. and Levin, Z. and Bertold, T. and Sandlerman, N.},
	month = sep,
	year = {1981},
	note = {Publisher: American Meteorological Society
Section: Journal of Applied Meteorology and Climatology},
	pages = {1013--1019},
	file = {Full Text PDF:/home/dasilva/snap/zotero-snap/common/Zotero/storage/SR9VUHWN/Yankofsky et al. - 1981 - Some Basic Characteristics of Bacterial Freezing N.pdf:application/pdf},
}

@article{burrows_bacteria_2009,
	title = {Bacteria in the global atmosphere – {Part} 2: {Modeling} of emissions and transport between different ecosystems},
	volume = {9},
	issn = {1680-7316},
	shorttitle = {Bacteria in the global atmosphere – {Part} 2},
	url = {https://acp.copernicus.org/articles/9/9281/2009/},
	doi = {10.5194/acp-9-9281-2009},
	abstract = {Bacteria are constantly being transported through the atmosphere, which may have implications for human health, agriculture, cloud formation, and the dispersal of bacterial species. We simulate the global transport of bacteria, represented as 1 μm and 3 μm diameter spherical solid particle tracers in a general circulation model. We investigate factors influencing residence time and distribution of the particles, including emission region, cloud condensation nucleus activity and removal by ice-phase precipitation. The global distribution depends strongly on the assumptions made about uptake into cloud droplets and ice. The transport is also affected, to a lesser extent, by the emission region, particulate diameter, and season. We find that the seasonal variation in atmospheric residence time is insufficient to explain by itself the observed seasonal variation in concentrations of particulate airborne culturable bacteria, indicating that this variability is mainly driven by seasonal variations in culturability and/or emission strength. We examine the potential for exchange of bacteria between ecosystems and obtain rough estimates of the flux from each ecosystem by using a maximum likelihood estimation technique, together with a new compilation of available observations described in a companion paper. Globally, we estimate the total emissions of bacteria-containing particles to the atmosphere to be 7.6\&times;1023–3.5\&times;1024 a\&minus;1, originating mainly from grasslands, shrubs and crops. We estimate the mass of emitted bacteria- to be 40–1800 Gg a\&minus;1, depending on the mass fraction of bacterial cells in the particles. In order to improve understanding of this topic, more measurements of the bacterial content of the air and of the rate of surface-atmosphere exchange of bacteria will be necessary. Future observations in wetlands, hot deserts, tundra, remote glacial and coastal regions and over oceans will be of particular interest.},
	language = {English},
	number = {23},
	urldate = {2023-08-28},
	journal = {Atmospheric Chemistry and Physics},
	author = {Burrows, S. M. and Butler, T. and Jöckel, P. and Tost, H. and Kerkweg, A. and Pöschl, U. and Lawrence, M. G.},
	month = dec,
	year = {2009},
	note = {Publisher: Copernicus GmbH},
	pages = {9281--9297},
	file = {Full Text PDF:/home/dasilva/snap/zotero-snap/common/Zotero/storage/JBF8LXKS/Burrows et al. - 2009 - Bacteria in the global atmosphere – Part 2 Modeli.pdf:application/pdf},
}

