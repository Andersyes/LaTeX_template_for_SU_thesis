	year = {2017},
	pages = {A119--A119},
	file = {Full Text PDF:/home/dasilva/snap/zotero-snap/common/Zotero/storage/UCALENTZ/Knust - 2017 - Polar Research and Supply Vessel POLARSTERN Operat.pdf:application/pdf},
}

