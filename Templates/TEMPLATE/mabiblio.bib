@article{chenMultidecadalTrendsVariability2023a,
  title = {Multi-Decadal Trends and Variability in Burned Area from the Fifth Version of the {{Global Fire Emissions Database}} ({{GFED5}})},
  author = {Chen, Yang and Hall, Joanne and {van Wees}, Dave and Andela, Niels and Hantson, Stijn and Giglio, Louis and {van der Werf}, Guido R. and Morton, Douglas C. and Randerson, James T.},
  year = {2023},
  month = nov,
  journal = {Earth System Science Data},
  volume = {15},
  number = {11},
  pages = {5227--5259},
  publisher = {Copernicus GmbH},
  issn = {1866-3508},
  doi = {10.5194/essd-15-5227-2023},
  urldate = {2024-12-23},
  abstract = {Long-term records of burned area are needed to understand wildfire dynamics, assess fire impacts on ecosystems and air quality, and improve fire forecasts. Here, we fuse multiple streams of remote sensing data to create a 24 year (1997--2020) dataset of monthly burned area as a component of the fifth version of the Global Fire Emissions Database (GFED5). During 2001--2020, we use the Moderate Resolution Imaging Spectroradiometer (MODIS) MCD64A1 burned area product and adjust for the errors of commission and omission. Adjustment factors are estimated based on region, land cover, and tree cover fraction, using spatiotemporally aligned burned area from Landsat or Sentinel-2. Burned area in croplands, peatlands, and deforestation regions is estimated from MODIS active fire detections. Along-Track Scanning Radiometer (ATSR) and Visible and Infrared Scanner (VIRS) active fire data are used to extend the time series back to 1997. The global annual burned area during 2001--2020 is estimated to be 774 {\textpm} 63 Mha yr-1 or 5.9 {\textpm} 0.5 \% of ice-free land. Burned area declined by 1.21 {\textpm} 0.66 \% yr-1, a cumulative decrease of 24.2 {\textpm} 13.2 \% over 20 years. The global reduction is primarily driven by a decrease in fires in savannas, grasslands, and croplands. Forest, peat, and deforestation fires did not exhibit significant long-term trends. The GFED5 global burned area is 93 \% higher than MCD64A1, 61 \% higher than GFED4s, and in closer agreement with products from higher-resolution satellite sensors. These data may reduce discrepancies between fire emission estimates from activity-based and atmospheric-based approaches, and improve our understanding of global fire impacts on the carbon cycle and climate system. The GFED5 global burned area product is freely accessible at https://doi.org/10.5281/zenodo.7668423 (Chen et al., 2023).},
  langid = {english},
  file = {/home/ehret/snap/zotero-snap/common/Zotero/storage/VECIXRRG/Chen et al. - 2023 - Multi-decadal trends and variability in burned area from the fifth version of the Global Fire Emissi.pdf}
}

@article{chenReviewBiomassBurning2017,
  title = {A Review of Biomass Burning: {{Emissions}} and Impacts on Air Quality, Health and Climate in {{China}}},
  shorttitle = {A Review of Biomass Burning},
  author = {Chen, Jianmin and Li, Chunlin and Ristovski, Zoran and Milic, Andelija and Gu, Yuantong and Islam, Mohammad S. and Wang, Shuxiao and Hao, Jiming and Zhang, Hefeng and He, Congrong and Guo, Hai and Fu, Hongbo and Miljevic, Branka and Morawska, Lidia and Thai, Phong and Lam, Yun Fat and Pereira, Gavin and Ding, Aijun and Huang, Xin and Dumka, Umesh C.},
  year = {2017},
  month = feb,
  journal = {Science of The Total Environment},
  volume = {579},
  pages = {1000--1034},
  issn = {0048-9697},
  doi = {10.1016/j.scitotenv.2016.11.025},
  urldate = {2024-07-24},
  abstract = {Biomass burning (BB) is a significant air pollution source, with global, regional and local impacts on air quality, public health and climate. Worldwide an extensive range of studies has been conducted on almost all the aspects of BB, including its specific types, on quantification of emissions and on assessing its various impacts. China is one of the countries where the significance of BB has been recognized, and a lot of research efforts devoted to investigate it, however, so far no systematic reviews were conducted to synthesize the information which has been emerging. Therefore the aim of this work was to comprehensively review most of the studies published on this topic in China, including literature concerning field measurements, laboratory studies and the impacts of BB indoors and outdoors in China. In addition, this review provides insights into the role of wildfire and anthropogenic BB on air quality and health globally. Further, we attempted to provide a basis for formulation of policies and regulations by policy makers in China.},
  keywords = {Air quality,Biomass burning,China,Climate,Emission,Health},
  file = {/home/ehret/snap/zotero-snap/common/Zotero/storage/2NFVU5IA/Chen et al. - 2017 - A review of biomass burning Emissions and impacts.pdf;/home/ehret/snap/zotero-snap/common/Zotero/storage/E3DPXTJ4/S0048969716324561.html}
}

