  author = {N{\'e}d{\'e}lec, Philippe and Blot, Romain and Boulanger, Damien and Athier, Gilles and Cousin, Jean-Marc and Gautron, Benoit and Petzold, Andreas and {Volz-Thomas}, Andreas and Thouret, Val{\'e}rie},
