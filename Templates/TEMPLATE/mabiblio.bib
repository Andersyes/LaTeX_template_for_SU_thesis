  author = {Antokhin, P. N. and Arshinova, V. G. and Arshinov, M. Y. and Belan, B. D. and Belan, S. B. and Davydov, D. K. and Ivlev, G. A. and Fofonov, A. V. and Kozlov, A. V. and Paris, J.-D. and Nedelec, P. and Rasskazchikova, T. M. and Savkin, D. E. and Simonenkov, D. V. and Sklyadneva, T. K. and Tolmachev, G. N.},
