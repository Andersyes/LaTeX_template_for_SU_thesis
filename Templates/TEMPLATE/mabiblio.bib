@article{kelleyHowContemporaryBioclimatic2019,
  title = {How Contemporary Bioclimatic and Human Controls Change Global Fire Regimes},
  author = {Kelley, Douglas I. and Bistinas, Ioannis and Whitley, Rhys and Burton, Chantelle and Marthews, Toby R. and Dong, Ning},
  year = {2019},
  month = sep,
  journal = {Nature Climate Change},
  volume = {9},
  number = {9},
  pages = {690--696},
  publisher = {Nature Publishing Group},
  issn = {1758-6798},
  doi = {10.1038/s41558-019-0540-7},
  urldate = {2024-12-27},
  abstract = {Anthropogenically driven declines in tropical savannah burnt area1,2 have recently received attention due to their effect on trends in global burnt area3,4. Large-scale trends in ecosystems where vegetation has adapted to infrequent fire, especially in cooler and wetter forested areas, are less well understood. Here, small changes in fire regimes can have a substantial impact on local biogeochemistry5. To investigate trends in fire across a wide range of ecosystems, we used Bayesian inference6 to quantify four primary controls on burnt area: fuel continuity, fuel moisture, ignitions and anthropogenic suppression. We found that fuel continuity and moisture are the dominant limiting factors of burnt area globally. Suppression is most important in cropland areas, whereas savannahs and boreal forests are most sensitive to ignitions. We quantify fire regime shifts in areas with more than one, and often counteracting, trends in these controls. Forests are of particular concern, where we show average shifts in controls of 2.3--2.6\% of their potential maximum per year, mainly driven by trends in fuel continuity and moisture. This study gives added importance to understanding long-term future changes in the controls on fire and the effect of fire trends on ecosystem function.},
  copyright = {2019 The Author(s), under exclusive licence to Springer Nature Limited},
  langid = {english},
  keywords = {Biogeochemistry,Climate change,Climate sciences,Climate-change impacts,Environmental impact},
  file = {/home/ehret/snap/zotero-snap/common/Zotero/storage/XJPTPNY6/Kelley et al. - 2019 - How contemporary bioclimatic and human controls change global fire regimes.pdf}
}

